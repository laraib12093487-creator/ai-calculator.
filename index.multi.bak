<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>All-in-One Calculator — Age, BMI, GPA, Loan, Currency &amp; More</title>
<meta name="description" content="A fast, private, all-in-one calculator dashboard: age, BMI, percentage, GPA, loan, currency, unit conversion and a basic calculator. No sign-up, works offline." />
<meta name="theme-color" content="#0f172a" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="assets/css/styles.css" />
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='24' fill='%234f46e5'/%3E%3Ctext x='50' y='69' font-family='Inter,sans-serif' font-size='58' font-weight='700' fill='white' text-anchor='middle'%3E%C3%97%3C/text%3E%3C/svg%3E" />
</head>
<body>
<a class="skip-link" href="#main">Skip to calculators</a>

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="#top">
      <span class="brand-mark" aria-hidden="true">×</span>
      <span class="brand-text">
        <strong>All-in-One Calculator</strong>
        <small>Fast · Private · Accurate</small>
      </span>
    </a>

    <div class="header-actions">
      <div class="search">
        <label class="sr-only" for="tool-search">Search calculators</label>
        <input id="tool-search" type="search" placeholder="Search tools…" autocomplete="off" spellcheck="false" />
        <ul id="search-results" class="search-results" role="listbox" hidden></ul>
      </div>
      <button id="theme-toggle" class="icon-btn" type="button" aria-pressed="false" title="Toggle dark mode">
        <span class="theme-icon" aria-hidden="true"></span>
        <span class="sr-only">Toggle dark mode</span>
      </button>
    </div>
  </div>
</header>

<main id="main">
  <section class="wrap hero" id="top">
    <h1>Every calculator you need, on one page</h1>
    <p class="lede">Eight accurate, instant calculators. Everything runs in your browser — nothing you type is uploaded or stored.</p>
    <ul class="hero-chips">
      <li>No sign-up</li>
      <li>Works offline</li>
      <li>Keyboard friendly</li>
      <li>Light &amp; dark</li>
    </ul>
  </section>

  <div class="wrap layout">
    <nav class="tool-nav" aria-label="Calculators">
      <ul>
        <li><a href="#basic" class="nav-link active">Basic</a></li>
        <li><a href="#age" class="nav-link">Age</a></li>
        <li><a href="#bmi" class="nav-link">BMI</a></li>
        <li><a href="#percentage" class="nav-link">Percentage</a></li>
        <li><a href="#gpa" class="nav-link">GPA</a></li>
        <li><a href="#loan" class="nav-link">Loan</a></li>
        <li><a href="#currency" class="nav-link">Currency</a></li>
        <li><a href="#units" class="nav-link">Unit conversion</a></li>
      </ul>
    </nav>

    <div class="cards" id="cards">

      <!-- ============ BASIC ============ -->
      <article class="card" id="basic" data-name="basic calculator arithmetic">
        <header class="card-head">
          <h2>Basic calculator</h2>
          <p class="tag">Arithmetic</p>
        </header>
        <div class="card-body">
          <div class="display" id="basic-display" data-announce data-announce-label="Calculator result" role="img" aria-label="Calculator display, currently 0">0</div>
          <div class="calc-grid" id="basic-keys">
            <button type="button" class="key fn" data-act="clear">AC</button>
            <button type="button" class="key fn" data-act="sign">+/−</button>
            <button type="button" class="key fn" data-act="pct">%</button>
            <button type="button" class="key op" data-op="/">÷</button>

            <button type="button" class="key" data-digit="7">7</button>
            <button type="button" class="key" data-digit="8">8</button>
            <button type="button" class="key" data-digit="9">9</button>
            <button type="button" class="key op" data-op="*">×</button>

            <button type="button" class="key" data-digit="4">4</button>
            <button type="button" class="key" data-digit="5">5</button>
            <button type="button" class="key" data-digit="6">6</button>
            <button type="button" class="key op" data-op="-">−</button>

            <button type="button" class="key" data-digit="1">1</button>
            <button type="button" class="key" data-digit="2">2</button>
            <button type="button" class="key" data-digit="3">3</button>
            <button type="button" class="key op" data-op="+">+</button>

            <button type="button" class="key wide" data-act="zero">0</button>
            <button type="button" class="key" data-act="dot">.</button>
            <button type="button" class="key eq" data-act="equals">=</button>
          </div>
          <p class="hint">Keyboard works too: digits, <kbd>+</kbd> <kbd>-</kbd> <kbd>*</kbd> <kbd>/</kbd>, <kbd>Enter</kbd> =, <kbd>Esc</kbd> clears.</p>
          <p class="error" id="basic-error" role="alert" hidden></p>
        </div>
      </article>

      <!-- ============ AGE ============ -->
      <article class="card" id="age" data-name="age birthday date of birth time lived">
        <header class="card-head">
          <h2>Age calculator</h2>
          <p class="tag">Date &amp; time</p>
        </header>
        <div class="card-body">
          <form class="form" id="age-form" novalidate>
            <div class="field">
              <label for="age-dob">Date of birth</label>
              <input id="age-dob" name="dob" type="date" required />
              <p class="error" data-error-for="dob" role="alert" hidden></p>
            </div>
            <div class="field">
              <label for="age-ref">Calculate age at</label>
              <input id="age-ref" name="ref" type="date" required />
              <p class="hint">Defaults to today. Change it to project a future or past age.</p>
              <p class="error" data-error-for="ref" role="alert" hidden></p>
            </div>
          </form>
          <div class="result" id="age-result" data-announce></div>
        </div>
      </article>

      <!-- ============ BMI ============ -->
      <article class="card" id="bmi" data-name="bmi body mass index weight height">
        <header class="card-head">
          <h2>BMI calculator</h2>
          <p class="tag">Health</p>
        </header>
        <div class="card-body">
          <form class="form" id="bmi-form" novalidate>
            <div class="grid-2">
              <div class="field">
                <label for="bmi-weight">Weight</label>
                <div class="input-affix">
                  <input id="bmi-weight" name="weight" type="number" inputmode="decimal" min="1" max="700" step="0.1" placeholder="70" required />
                  <span class="unit" data-unit="bmi-weight">kg</span>
                </div>
                <p class="error" data-error-for="weight" role="alert" hidden></p>
              </div>
              <div class="field">
                <label for="bmi-height">Height</label>
                <div class="input-affix">
                  <input id="bmi-height" name="height" type="number" inputmode="decimal" min="30" max="260" step="0.1" placeholder="175" required />
                  <span class="unit" data-unit="bmi-height">cm</span>
                </div>
                <p class="error" data-error-for="height" role="alert" hidden></p>
              </div>
            </div>
            <div class="field">
              <span class="label-like" id="bmi-sys-label">Unit system</span>
              <div class="segmented two" role="radiogroup" aria-labelledby="bmi-sys-label" id="bmi-sys">
                <button type="button" role="radio" aria-checked="true" data-value="metric" class="on">Metric</button>
                <button type="button" role="radio" aria-checked="false" data-value="imperial">Imperial</button>
              </div>
            </div>
          </form>
          <div class="result" id="bmi-result" data-announce></div>
          <div class="scale" id="bmi-scale" aria-hidden="true">
            <div class="scale-track"><span class="scale-marker" id="bmi-marker"></span></div>
            <div class="scale-labels"><span>Under</span><span>Healthy</span><span>Over</span><span>Obese</span></div>
          </div>
          <p class="disclaimer">BMI is a population screening tool, not a diagnosis. It does not distinguish muscle from fat.</p>
        </div>
      </article>

      <!-- ============ PERCENTAGE ============ -->
      <article class="card" id="percentage" data-name="percentage percent of change increase decrease">
        <header class="card-head">
          <h2>Percentage calculator</h2>
          <p class="tag">Math</p>
        </header>
        <div class="card-body">
          <form class="form" id="pct-form" novalidate>
            <div class="field">
              <span class="label-like" id="pct-mode-label">What do you want to find?</span>
              <div class="segmented" role="radiogroup" aria-labelledby="pct-mode-label" id="pct-mode">
                <button type="button" role="radio" aria-checked="true" data-value="of" class="on">X% of Y</button>
                <button type="button" role="radio" aria-checked="false" data-value="what">X is what % of Y</button>
                <button type="button" role="radio" aria-checked="false" data-value="change">% change</button>
                <button type="button" role="radio" aria-checked="false" data-value="add">Add %</button>
                <button type="button" role="radio" aria-checked="false" data-value="sub">Subtract %</button>
              </div>
            </div>
            <div class="grid-2">
              <div class="field">
                <label for="pct-a" id="pct-a-label">Percentage</label>
                <div class="input-affix">
                  <input id="pct-a" name="a" type="number" inputmode="decimal" step="any" placeholder="15" required />
                  <span class="unit" id="pct-a-unit">%</span>
                </div>
                <p class="error" data-error-for="a" role="alert" hidden></p>
              </div>
              <div class="field">
                <label for="pct-b" id="pct-b-label">Of value</label>
                <input id="pct-b" name="b" type="number" inputmode="decimal" step="any" placeholder="200" required />
                <p class="error" data-error-for="b" role="alert" hidden></p>
              </div>
            </div>
          </form>
          <div class="result" id="pct-result" data-announce></div>
          <p class="formula" id="pct-formula"></p>
        </div>
      </article>

      <!-- ============ GPA ============ -->
      <article class="card wide" id="gpa" data-name="gpa grade point average credits scale weighted">
        <header class="card-head">
          <h2>GPA calculator</h2>
          <p class="tag">Grades</p>
        </header>
        <div class="card-body">
          <form class="form" id="gpa-form" novalidate>
            <div class="grid-3">
              <div class="field">
                <label for="gpa-scale">Grading scale</label>
                <select id="gpa-scale" name="scale">
                  <option value="4.0">4.0 scale (A=4, B=3, C=2, D=1)</option>
                  <option value="4.3">4.3 scale (+ / −, A+=4.3)</option>
                  <option value="5.0">5.0 scale (A=5, B=4, …)</option>
                  <option value="10">10-point scale</option>
                  <option value="100">Percentage (0–100)</option>
                </select>
              </div>
              <div class="field">
                <label for="gpa-weight">Weight credits?</label>
                <select id="gpa-weight" name="weightMode">
                  <option value="no">No — equal weight</option>
                  <option value="yes">Yes — by course credits</option>
                </select>
              </div>
              <div class="field">
                <label for="gpa-round">Round result to</label>
                <select id="gpa-round" name="round">
                  <option value="2">2 decimals</option>
                  <option value="3">3 decimals</option>
                  <option value="4">4 decimals</option>
                </select>
              </div>
            </div>
          </form>

          <div class="table-wrap">
            <table class="gpa-table">
              <caption class="sr-only">Course grades and credits</caption>
              <thead>
                <tr>
                  <th scope="col">Course (optional)</th>
                  <th scope="col">Grade</th>
                  <th scope="col" class="num">Credits</th>
                  <th scope="col" class="num">Points</th>
                  <th scope="col"><span class="sr-only">Remove</span></th>
                </tr>
              </thead>
              <tbody id="gpa-rows"></tbody>
            </table>
          </div>
          <div class="row-actions">
            <button type="button" class="btn ghost" id="gpa-add">+ Add course</button>
            <button type="button" class="btn ghost" id="gpa-clear">Clear all</button>
            <button type="button" class="btn ghost" id="gpa-sample">Load example</button>
          </div>

          <div class="result" id="gpa-result" data-announce></div>
          <p class="disclaimer">Mapping follows the standard US convention (A− = 3.7 on the 4.0 scale) plus the selected scale. Letter-grade cut-offs vary by institution — check your syllabus.</p>
        </div>
      </article>

      <!-- ============ LOAN ============ -->
      <article class="card" id="loan" data-name="loan mortgage amortization interest monthly payment">
        <header class="card-head">
          <h2>Loan calculator</h2>
          <p class="tag">Finance</p>
        </header>
        <div class="card-body">
          <form class="form" id="loan-form" novalidate>
            <div class="field">
              <label for="loan-amount">Loan amount</label>
              <div class="input-affix">
                <input id="loan-amount" name="amount" type="number" inputmode="decimal" min="1" step="any" placeholder="250000" required />
                <span class="unit" data-unit="loan-amount">USD</span>
              </div>
              <p class="error" data-error-for="amount" role="alert" hidden></p>
            </div>
            <div class="grid-2">
              <div class="field">
                <label for="loan-rate">Annual interest rate</label>
                <div class="input-affix">
                  <input id="loan-rate" name="rate" type="number" inputmode="decimal" min="0" max="100" step="0.01" placeholder="6.5" required />
                  <span class="unit">%</span>
                </div>
                <p class="error" data-error-for="rate" role="alert" hidden></p>
              </div>
              <div class="field">
                <label for="loan-term">Term</label>
                <div class="input-affix">
                  <input id="loan-term" name="term" type="number" inputmode="numeric" min="1" max="60" step="1" placeholder="30" required />
                  <span class="unit">years</span>
                </div>
                <p class="error" data-error-for="term" role="alert" hidden></p>
              </div>
            </div>
            <div class="field">
              <label for="loan-extra">Extra monthly payment (optional)</label>
              <div class="input-affix">
                <input id="loan-extra" name="extra" type="number" inputmode="decimal" min="0" step="any" placeholder="0" />
                <span class="unit" data-unit="loan-extra">USD</span>
              </div>
            </div>
            <label class="check">
              <input type="checkbox" id="loan-insurance" />
              <span>Include estimated monthly property tax &amp; insurance</span>
            </label>
            <div class="grid-2" id="loan-extra-fields" hidden>
              <div class="field">
                <label for="loan-tax">Property tax / year</label>
                <div class="input-affix">
                  <input id="loan-tax" name="tax" type="number" inputmode="decimal" min="0" step="any" placeholder="3600" />
                  <span class="unit" data-unit="loan-tax">USD</span>
                </div>
              </div>
              <div class="field">
                <label for="loan-ins">Home insurance / year</label>
                <div class="input-affix">
                  <input id="loan-ins" name="ins" type="number" inputmode="decimal" min="0" step="any" placeholder="1200" />
                  <span class="unit" data-unit="loan-ins">USD</span>
                </div>
              </div>
            </div>
          </form>
          <div class="result" id="loan-result" data-announce></div>
          <details class="amort">
            <summary>Payment schedule (first 12 months)</summary>
            <div class="table-wrap">
              <table class="amort-table">
                <caption class="sr-only">First twelve payments</caption>
                <thead><tr><th scope="col" class="num">#</th><th scope="col">Payment</th><th scope="col">Principal</th><th scope="col">Interest</th><th scope="col" class="num">Balance</th></tr></thead>
                <tbody id="amort-body"></tbody>
              </table>
            </div>
          </details>
          <p class="disclaimer">Estimate only. Uses standard amortisation; excludes fees, PMI, points and compounding differences. Not financial advice.</p>
        </div>
      </article>

      <!-- ============ CURRENCY ============ -->
      <article class="card" id="currency" data-name="currency exchange rate convert money usd eur">
        <header class="card-head">
          <h2>Currency converter</h2>
          <p class="tag">Exchange rates</p>
        </header>
        <div class="card-body">
          <form class="form" id="cur-form" novalidate>
            <div class="field">
              <label for="cur-amount">Amount</label>
              <input id="cur-amount" name="amount" type="number" inputmode="decimal" min="0" step="any" placeholder="100" required />
              <p class="error" data-error-for="amount" role="alert" hidden></p>
            </div>
            <div class="grid-2">
              <div class="field">
                <label for="cur-from">From</label>
                <select id="cur-from" name="from"></select>
              </div>
              <div class="field">
                <label for="cur-to">To</label>
                <select id="cur-to" name="to"></select>
              </div>
            </div>
            <div class="row-actions">
              <button type="button" class="btn ghost" id="cur-swap" title="Swap currencies">⇄ Swap</button>
              <button type="button" class="btn ghost" id="cur-refresh">Refresh live rates</button>
            </div>
          </form>
          <div class="result big" id="cur-result" data-announce></div>
          <p class="rate-note" id="cur-note"></p>
          <div class="rate-status" id="cur-status" data-state="loading">
            <span class="dot" aria-hidden="true"></span><span id="cur-status-text">Loading live rates…</span>
          </div>
          <p class="disclaimer">Rates are mid-market reference values with no fees or margin. Banks and card networks add a spread, so you will never get exactly this rate. Check your provider before converting large amounts.</p>
        </div>
      </article>

      <!-- ============ UNITS ============ -->
      <article class="card wide" id="units" data-name="unit conversion length weight temperature volume speed time data">
        <header class="card-head">
          <h2>Unit converter</h2>
          <p class="tag">Conversions</p>
        </header>
        <div class="card-body">
          <form class="form" id="unit-form" novalidate>
            <div class="field">
              <label for="unit-cat">Category</label>
              <select id="unit-cat" name="cat"></select>
            </div>
            <div class="field">
              <label for="unit-value">Value</label>
              <input id="unit-value" name="value" type="number" inputmode="decimal" step="any" placeholder="10" required />
              <p class="error" data-error-for="value" role="alert" hidden></p>
            </div>
            <div class="grid-2">
              <div class="field">
                <label for="unit-from">From</label>
                <select id="unit-from" name="from"></select>
              </div>
              <div class="field">
                <label for="unit-to">To</label>
                <select id="unit-to" name="to"></select>
              </div>
            </div>
            <div class="row-actions">
              <button type="button" class="btn ghost" id="unit-swap" title="Swap units">⇄ Swap</button>
            </div>
          </form>
          <div class="result big" id="unit-result" data-announce></div>
          <div class="table-wrap" id="unit-table-wrap" hidden>
            <table class="unit-table">
              <caption>All units in this category</caption>
              <thead><tr><th scope="col">Unit</th><th scope="col" class="num">Value</th></tr></thead>
              <tbody id="unit-table"></tbody>
            </table>
          </div>
          <p class="formula" id="unit-formula"></p>
        </div>
      </article>

    </div>
  </div>
</main>

<footer class="site-footer">
  <div class="wrap">
    <p><strong>All-in-One Calculator</strong> — built with plain HTML, CSS and JavaScript. All calculations run locally in your browser; no data is collected or sent anywhere. Currency rates are the only network request, and they are optional.</p>
    <p class="small">Educational tool. Loan and health outputs are estimates, not professional advice. Always verify important figures with a qualified source.</p>
  </div>
</footer>

<div id="sr-live" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></div>

<script src="assets/js/core.js"></script>
<script src="assets/js/basic.js"></script>
<script src="assets/js/age.js"></script>
<script src="assets/js/bmi.js"></script>
<script src="assets/js/percentage.js"></script>
<script src="assets/js/gpa.js"></script>
<script src="assets/js/loan.js"></script>
<script src="assets/js/currency.js"></script>
<script src="assets/js/units.js"></script>
<script src="assets/js/app.js"></script>
</body>
</html>
